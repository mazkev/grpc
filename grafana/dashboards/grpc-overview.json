      "id": 2,
      "title": "💬 Pesan Chat LiveChat Masuk",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "grpc_chat_messages_total",
          "legendFormat": "Pesan Terkirim",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "⚡ Efektivitas Redis Caching",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "redis_cache_hits_total",
          "legendFormat": "Hits (Cepat)",
          "refId": "A"
        },
        {
          "expr": "redis_cache_misses_total",
          "legendFormat": "Misses (DB)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "📈 Grafik Tren Aktivitas Realtime",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method) (increase(grpc_requests_total[1h]))",
          "legendFormat": "RPC: {{method}}",
          "refId": "A"
        },
        {
          "expr": "increase(grpc_chat_messages_total[1h])",
          "legendFormat": "💬 Chat Messages",
          "refId": "B"
        }
      ]
    }
  ],
